# ===================================================================
# Tourist Guide & TravelMind AI — Environment Configuration Template
# Copy this file to .env and provide your actual credentials
# ===================================================================

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tourist_chatbot?retryWrites=true&w=majority
DATABASE_NAME=tourist_chatbot

# JWT Secret Key (HMAC-SHA256 at least 32 bytes / 256 bits)
# Generate with: openssl rand -base64 48
JWT_SECRET=your_generated_jwt_secret_here

# Opt-in demo user creation (default: false)
SEED_DEMO=false

# Server Port
SERVER_PORT=8080

# CORS Allowed Origins (comma-separated, no trailing slash)
# List every frontend URL that is allowed to call the backend.
# Example for Vercel + local dev:
#   CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:8080,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5000,http://localhost:3000
